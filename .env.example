# Optional shared Lexi account identity for local development.
# Use the same Supabase project URL and browser-safe publishable key as Lexi Words.
# Never place a service_role, sb_secret_ key, or AI provider key in VITE_* variables.
# Leave every value empty to keep the local-only mode.
VITE_LEXI_ENVIRONMENT=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_REF=

# Staging must use an isolated non-production project and all four values:
# VITE_LEXI_ENVIRONMENT=staging
# VITE_SUPABASE_URL=https://<staging-project-ref>.supabase.co
# VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# VITE_SUPABASE_PROJECT_REF=<staging-project-ref>

# Formal production builds use the reviewed browser-public values committed in
# .env.production. Rotate that publishable key through Supabase if needed, then
# update .env.production and run npm run verify:release before publishing.
