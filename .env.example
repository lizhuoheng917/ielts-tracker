# Optional shared Lexi account identity for local development.
# Use the same Supabase project URL and browser-safe publishable key as Lexi Words.
# Never place a service_role, sb_secret_ key, or AI provider key in VITE_* variables.
# Leave every value empty to keep the local-only mode.
VITE_LEXI_ENVIRONMENT=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_REF=

# Optional public URL of the ordinary-user Lexi Account center. When empty,
# Tracker uses the reviewed https://lexi-account.pages.dev default. This is an
# address only; never add access tokens, server secrets, or provider keys here.
VITE_LEXI_ACCOUNT_URL=

# Optional public root URL for the separate Lexi Words learner product. The
# reviewed production default is used when empty. HTTP is accepted only for a
# loopback development server; never append account IDs, tokens, or deep links.
VITE_LEXI_WORDS_APP_URL=

# Staging must use an isolated non-production project and all four values:
# VITE_LEXI_ENVIRONMENT=staging
# VITE_SUPABASE_URL=https://<staging-project-ref>.supabase.co
# VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# VITE_SUPABASE_PROJECT_REF=<staging-project-ref>

# Formal production builds use the reviewed browser-public values committed in
# .env.production. Rotate that publishable key through Supabase if needed, then
# update .env.production and run npm run verify:release before publishing.
# Supabase Auth Redirect URLs are configured in the Dashboard, not in Vite.
# Before releasing this app, allow the Tracker origin with `/**`, including
# `/auth/confirmed` for signup verification and `/login` for password recovery.
